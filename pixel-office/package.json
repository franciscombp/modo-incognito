{
  "name": "pixel-office",
  "version": "1.0.0",
  "description": "Modo Incógnito — oficina isométrica oblicua en Three.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sprites": "python3 tools/gen_sprites.py",
    "check:reachable": "node tools/check-reachable.mjs",
    "check:chase": "node tools/check-chase.mjs",
    "check": "npm run check:reachable && npm run check:chase",
    "check:visual": "node tools/shoot.mjs",
    "sync:root": "node tools/sync-root.mjs",
    "build:pages": "npm run build && npm run sync:root",
    "check:menus": "node tools/shoot-menus.mjs",
    "format:data": "node tools/format-data.mjs"
  },
  "license": "ISC",
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "playwright": "^1.62.0",
    "vite": "^8.1.5"
  }
}
